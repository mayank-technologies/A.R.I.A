<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Dark translucent structural body of geometric 'A' with hollow triangle cutout (transparent canvas) -->
    <path
        android:fillColor="#D9040C1E"
        android:fillType="evenOdd"
        android:pathData="M46,20 L60,20 L86,86 L72,86 L65.7,70 L40.3,70 L34,86 L20,86 Z M53,38 L45,58 L61,58 Z" />

    <!-- Sharp beveled outer stroke with glowing cyan to electric-blue gradient -->
    <path
        android:pathData="M46,20 L60,20 L86,86 L72,86 L65.7,70 L40.3,70 L34,86 L20,86 Z"
        android:strokeWidth="2.4"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="20"
                android:startY="20"
                android:endX="86"
                android:endY="86"
                android:type="linear">
                <item android:color="#7DF9FF" android:offset="0.0" />
                <item android:color="#00E5FF" android:offset="0.45" />
                <item android:color="#38BDF8" android:offset="0.80" />
                <item android:color="#0284C7" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Crisp inner triangular aperture bevel -->
    <path
        android:pathData="M53,38 L45,58 L61,58 Z"
        android:strokeWidth="1.7"
        android:strokeLineJoin="miter"
        android:strokeColor="#5CEBFF" />

    <!-- Internal angular circuit bus traces inside the 'A' legs & crossbar -->
    <path
        android:pathData="M27,82 L49.5,25 L56.5,25 L79,82"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="miter">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="27"
                android:startY="25"
                android:endX="79"
                android:endY="82"
                android:type="linear">
                <item android:color="#00F0FF" android:offset="0.0" />
                <item android:color="#0284C7" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Crossbar horizontal circuit trace -->
    <path
        android:pathData="M33.5,64 L72.5,64"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeColor="#00E5FF" />

    <!-- Angular upper-right circuit trace extending to corner power node -->
    <path
        android:pathData="M64.5,51.5 L75.5,40.5 L75.5,29.5 L81,24 L89.5,24"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeColor="#00F0FF" />

    <!-- Soft radial glow halo behind the corner power-indicator node -->
    <path android:pathData="M83,24 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="90"
                android:centerY="24"
                android:gradientRadius="7"
                android:type="radial">
                <item android:color="#AA00F0FF" android:offset="0.0" />
                <item android:color="#4000E5FF" android:offset="0.55" />
                <item android:color="#0000E5FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Corner power-indicator node outer ring & ice-white core -->
    <path
        android:fillColor="#00F0FF"
        android:pathData="M86.2,24 a3.8,3.8 0 1,0 7.6,0 a3.8,3.8 0 1,0 -7.6,0" />
    <path
        android:fillColor="#ECFEFF"
        android:pathData="M88.1,24 a1.9,1.9 0 1,0 3.8,0 a1.9,1.9 0 1,0 -3.8,0" />
</vector>
